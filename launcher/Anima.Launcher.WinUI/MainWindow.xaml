<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Anima.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (caption buttons drawn by the system to the right) -->
        <Grid x:Name="AppTitleBar" Height="48">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <FontIcon Glyph="&#xE80F;" FontSize="16" Margin="0,0,10,0" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Anima Random Studio" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                <TextBlock Text="安装与启动" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="200"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsPaneToggleButtonVisible="True"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="服务" Tag="home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="环境" Tag="env">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="模型与节点" Tag="models">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="日志" Tag="logs">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE70B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <InfoBar
            x:Name="StatusBar"
            Grid.Row="2"
            IsOpen="True"
            Severity="Informational"
            IsClosable="False"
            Message="首次配置：选择目录 → 检查/安装环境 → 勾选模型 → 启动工作台" />

        <CommandBar Grid.Row="3" DefaultLabelPosition="Right" HorizontalContentAlignment="Stretch">
            <CommandBar.Content>
                <Grid />
            </CommandBar.Content>
            <AppBarButton x:Name="StartButton" Label="启动并打开工作台" Click="Start_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE768;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="StopButton" Label="停止本程序服务" Click="Stop_Click">
                <AppBarButton.Icon><FontIcon Glyph="&#xE71A;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="PauseButton" Label="暂停任务" Click="Pause_Click" IsEnabled="False">
                <AppBarButton.Icon><FontIcon Glyph="&#xE769;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="CancelButton" Label="取消下载" Click="Cancel_Click" IsEnabled="False">
                <AppBarButton.Icon><FontIcon Glyph="&#xE711;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="更多">
                <AppBarButton.Icon><FontIcon Glyph="&#xE712;" /></AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="打开工作台" Click="OpenWebUI_Click" />
                        <MenuFlyoutItem Text="打开 ComfyUI" Click="OpenComfy_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="重新检查模型和节点" Click="Rescan_Click" />
                        <MenuFlyoutItem Text="打开环境 / 安装页面" Click="GoEnvironment_Click" />
                        <MenuFlyoutItem Text="设置" Click="GoSettings_Click" />
                        <MenuFlyoutItem Text="打开日志目录" Click="OpenLogs_Click" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="退出（保留服务）" Click="ExitKeep_Click" />
                        <MenuFlyoutItem Text="停止服务并退出" Click="ExitStop_Click" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>

        <ProgressBar x:Name="TaskProgress" Grid.Row="4" Height="4" Minimum="0" Maximum="100" Value="0" />
    </Grid>
</Window>
