# Keep development files in Git, but export only the user source package.
* export-ignore
/Install.ps1 -export-ignore
/Start.ps1 -export-ignore
/Start.cmd -export-ignore
/run.py -export-ignore
/pyproject.toml -export-ignore
/LICENSE -export-ignore
